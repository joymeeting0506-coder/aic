<?xml version="1.0"?>
<!-- 智慧社区巡检机器人：差速底盘 + 2D LiDAR + RGB 相机 + IMU（Gazebo Harmonic） -->
<robot name="patrol_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
  <material name="grey"><color rgba="0.55 0.55 0.55 1"/></material>
  <material name="blue"><color rgba="0.15 0.35 0.75 1"/></material>

  <!-- 整车等比缩放系数：改这一个数即可整体改小/改大小车。
       只缩几何尺寸（车轮/底盘/传感器安装位），不动速度、视野、分辨率等
       功能参数，导航、SLAM、红绿灯识别均不受影响。 -->
  <xacro:arg name="scale" default="0.5"/>
  <xacro:property name="scale" value="$(arg scale)"/>

  <xacro:property name="wheel_radius" value="${0.05 * scale}"/>
  <xacro:property name="wheel_width" value="${0.025 * scale}"/>
  <xacro:property name="wheel_separation" value="${0.33 * scale}"/>
  <xacro:property name="half_sep" value="${wheel_separation / 2.0}"/>
  <xacro:property name="body_length" value="${0.32 * scale}"/>
  <xacro:property name="body_width" value="${0.24 * scale}"/>
  <xacro:property name="body_height" value="${0.10 * scale}"/>
  <!-- base_z 必须等于 wheel_radius：base_link 抬到轮轴高度，轮子才能贴地 -->
  <xacro:property name="base_z" value="${wheel_radius}"/>

  <!-- base_footprint 是 TF 树的根（贴地面），base_link 挂在它上方 base_z 处。
       顺序不能反：若 base_link 当根，KDL 会因「根节点带惯量」报警。 -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <mass value="2.5"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.03"/>
    </inertial>
    <visual>
      <origin xyz="0 0 ${0.02 * scale}" rpy="0 0 0"/>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${0.02 * scale}" rpy="0 0 0"/>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
    </collision>
  </link>

  <xacro:macro name="wheel" params="name y_pos">
    <link name="${name}">
      <inertial>
        <mass value="0.1"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.00006" ixy="0" ixz="0" iyy="0.00006" iyz="0" izz="0.00006"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${0.04 * scale} ${y_pos} 0" rpy="0 0 0"/>
      <!-- 轮轴必须指向 +Y：指向 -Y 会让 gz 的 DiffDrive 把 linear.x>0 解释成往 -X 走，
           小车就会“倒着走”（前进方向与车头相反，相机装在 +X 侧）。 -->
      <axis xyz="0 1 0"/>
    </joint>
    <gazebo reference="${name}">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:wheel name="left_wheel" y_pos="${half_sep}"/>
  <xacro:wheel name="right_wheel" y_pos="${-half_sep}"/>

  <link name="caster">
    <inertial>
      <mass value="0.02"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
    <visual><geometry><sphere radius="${0.025 * scale}"/></geometry><material name="grey"/></visual>
    <collision><geometry><sphere radius="${0.025 * scale}"/></geometry></collision>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster"/>
    <origin xyz="${-0.14 * scale} 0 ${-0.025 * scale}" rpy="0 0 0"/>
  </joint>
  <gazebo reference="caster">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
  </gazebo>

  <link name="lidar_link">
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual><geometry><cylinder radius="${0.03 * scale}" length="${0.04 * scale}"/></geometry><material name="black"/></visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${0.10 * scale}" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${0.16 * scale} 0 ${0.06 * scale}" rpy="0 -0.2 0"/>
  </joint>

  <link name="imu_link">
    <inertial>
      <mass value="0.02"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${0.04 * scale}" rpy="0 0 0"/>
  </joint>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <max_linear_acceleration>2.0</max_linear_acceleration>
      <min_linear_acceleration>-2.0</min_linear_acceleration>
      <max_angular_acceleration>4.0</max_angular_acceleration>
      <min_angular_acceleration>-4.0</min_angular_acceleration>
      <max_linear_velocity>0.5</max_linear_velocity>
      <min_linear_velocity>-0.5</min_linear_velocity>
      <max_angular_velocity>2.0</max_angular_velocity>
      <min_angular_velocity>-2.0</min_angular_velocity>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <update_rate>30</update_rate>
    </plugin>
  </gazebo>

  <!-- gz-sim 8 的 IMU 不由 sensors-system 处理，必须显式加载 imu-system 插件，
       否则 <sensor type="imu"> 会被静默丢弃、`gz topic -l` 里根本没有 /imu。 -->
  <gazebo>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range><min>0.1</min><max>12.0</max><resolution>0.01</resolution></range>
      </lidar>
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <topic>lidar</topic>
    </sensor>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image><width>640</width><height>480</height></image>
        <clip><near>0.05</near><far>20</far></clip>
      </camera>
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <topic>camera</topic>
    </sensor>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <always_on>1</always_on>
      <update_rate>50</update_rate>
      <visualize>true</visualize>
      <topic>imu</topic>
      <enable_metrics>true</enable_metrics>
    </sensor>
  </gazebo>

</robot>
